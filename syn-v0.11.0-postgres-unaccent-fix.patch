diff --git a/tests/positions/test_postgres.py b/tests/positions/test_postgres.py
index b9f2d35..f847f2a 100644
--- a/tests/positions/test_postgres.py
+++ b/tests/positions/test_postgres.py
@@ -30,8 +30,13 @@ def postgres():
     try:
         with admin.begin() as connection:
             connection.execute(text(f'CREATE SCHEMA "{name}"'))
-        # Do not inherit public's alembic_version or tables during the upgrade.
-        scoped = make_url(URL).update_query_dict({"options": f"-csearch_path={name}"})
+            connection.execute(text(
+                f'CREATE TABLE "{name}"."alembicVersion" '
+                "(version_num varchar(32) NOT NULL PRIMARY KEY)"
+            ))
+        # Keep migration/version state local while exposing database-wide
+        # extensions such as public.unaccent to the isolated schema.
+        scoped = make_url(URL).update_query_dict({"options": f"-csearch_path={name},public"})
         engine = createEngine(scoped.render_as_string(hide_password=False), migrate=True)
         sessions = sessionmaker(bind=engine, expire_on_commit=False)
         yield PositionStore(sessions), sessions
