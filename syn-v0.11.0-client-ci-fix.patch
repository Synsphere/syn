+        run: uv run --no-project --python .client-venv ruff check --isolated --select E4,E7,E9,F packages/syn-client/src packages/syn-client/tests scripts/ci_database.py scripts/build_release_contract.py scripts/stage_release.py scripts/ci_operator_native.py scripts/ci_operator_recovery.py scripts/ci_operator_consumer.py scripts/ci_operator_release.py scripts/check_operator_hd_reference.py scripts/private_interpreter.py scripts/ci_agent_native.py scripts/prepare_agent_runtime.py scripts/ci_agent_release.py scripts/ci_lan_enrollment.py scripts/ci_private_pubsub.py scripts/ci_potbot_private_mesh.py scripts/ci_group_rollover.py
