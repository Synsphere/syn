  "frames": [
    {
      "frameId": "label",
      "payload": {
        "format": "gap",
        "elements": [
          {
            "adType": 9,
            "dataHex": "53796e"
          }
        ]
      }
    }
  ],
  "schedule": {
    "mode": "single"
  }
